{
  "title": "Munchi",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "CHOMPI TAPE 2.0:",
        "7-voice sampler",
        "and tape looper.",
        "",
        "Takes over Move.",
        "Back twice exits.",
        "",
        "Pads are two",
        "octaves of keys,",
        "C3 to C5."
      ]
    },
    {
      "title": "Modes",
      "lines": [
        "KEYS: one sample",
        "played across",
        "the keyboard.",
        "",
        "KIT: each white",
        "key is its own",
        "slot. Top C is",
        "the buffer.",
        "",
        "Shift + C#3: Keys",
        "Shift + D#3: Kit",
        "Again: next bank"
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "1 Speed",
        "2 Start",
        "3 End",
        "4 Space",
        "5 Lofi",
        "6 Filter",
        "7 Loop speed",
        "8 Input",
        "Vol: Volume",
        "",
        "Right: 1-3 become",
        "Gain Attack Decay"
      ]
    },
    {
      "title": "Recording",
      "lines": [
        "Sample: record",
        "into the buffer.",
        "",
        "Track 4: monitor",
        "the input.",
        "",
        "Shift + F#3/G#3/",
        "A#3: Mic, Line,",
        "Resample."
      ]
    },
    {
      "title": "Looper",
      "lines": [
        "Loop: record,",
        "overdub, stop.",
        "Play: play/pause.",
        "",
        "Knob 7: speed,",
        "or scrub when",
        "stopped.",
        "",
        "Delete + Loop:",
        "clear."
      ]
    },
    {
      "title": "Save / Copy",
      "lines": [
        "Hold Shift.",
        "A#4: save buffer",
        "G#4: copy",
        "F#4: erase",
        "",
        "Pick a slot with",
        "a white key, then",
        "press Shift to",
        "confirm."
      ]
    },
    {
      "title": "The Card",
      "lines": [
        "Samples live in",
        "UserLibrary/",
        "Samples/Schwung/",
        "Munchi",
        "",
        "jammi_a1.wav =",
        "Keys, bank A,",
        "slot 1.",
        "cubbi_ = Kit."
      ]
    }
  ]
}
